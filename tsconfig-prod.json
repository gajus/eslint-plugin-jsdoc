{
  "compilerOptions": {
    "lib": ["es2023"],
    "moduleResolution": "nodenext",
    "module": "nodenext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": true,
    "strict": true,
    "skipLibCheck": true,
    "target": "es2024",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/*.js",
    "src/rules/*.js",
    "src/rules.d.ts",
    "src/utils/*.js",
  ],
  "exclude": ["node_modules", "src/bin/*.js"]
}
